{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bowling",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,s)=>{let n=p.basename(decodeURIComponent(q.url.split('?')[0]));if(!n||n==='/')n='bowling.html';if(!/\\.html$/.test(n)||!f.existsSync(n)){s.writeHead(404);return s.end();}f.readFile(n,(e,d)=>{s.writeHead(200,{'Content-Type':'text/html; charset=utf-8','Cache-Control':'no-store'});s.end(d)})}).listen(5317)"],
      "port": 5317
    }
  ]
}
